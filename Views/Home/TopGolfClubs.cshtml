@model IEnumerable<string>
@{
    ViewData["Title"] = "Top Golf Clubs";
    var clubs = Model ?? Array.Empty<string>();
}

<div class="text-center">
    <h1 class="display-4">Top Golf Clubs</h1>
    <p>Popular Top Golf Clubs</p>
    <ol class="list-group list-group-numbered">
        @foreach (var golfClub in clubs)
        {
            int index = clubs.ToList().IndexOf(golfClub);
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="p-3 mb-2 bg-light text-dark">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold">@golfClub</div>
                        This club is one of the best in the world and is known for its excellent facilities and beautiful courses.
                    </div>
                    <span class="badge text-bg-primary rounded-pill">{@index}</span>
                </div>
            </li>
        }
    </ol>
</div>
